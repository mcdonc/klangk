#!/usr/bin/env python3
"""Git credential helper that delegates to the user's browser.

Called by git as: git-credential-klangk get|store|erase

On "get": reads protocol/host/path from stdin. If an OAuth device-flow
provider is configured for the host (a KLANGKWS_FEATURE_OAUTH_PROVIDERS
entry, or the legacy KLANGKWS_FEATURE_GITHUB_OAUTH_CLIENT_ID shorthand
for github.com), runs that provider's device flow (RFC 8628: request the
code from the provider, show it in the browser, poll for the token).
Otherwise, or on fallback, delegates to the browser for a PAT dialog.
On "store"/"erase": forwards to the bridge so the frontend can update or
clear its credential cache.

Falls through (exit 1) when the bridge is unreachable or the user
cancels, letting git try the next configured helper or prompt.
"""

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

BRIDGE_URL = os.environ.get("KLANGKWS_BRIDGE_URL", "")
TIMEOUT = 30
# Device flow codes expire after 15 minutes; the credential get operation
# may block on user interaction (PAT dialog or device flow), so use a much
# longer timeout than the default bridge timeout.
GET_TIMEOUT = 900
# Provider map: JSON list of per-host OAuth device-flow configs. See
# _provider_entry for the entry shape.
PROVIDERS_ENV = "KLANGKWS_FEATURE_OAUTH_PROVIDERS"
# Legacy shorthand: a bare GitHub client ID that expands to the stock
# GitHub provider entry (kept for backward compatibility).
GITHUB_CLIENT_ID_ENV = "KLANGKWS_FEATURE_GITHUB_OAUTH_CLIENT_ID"
# Device-flow base URL for the legacy GitHub shorthand. Overridable so the
# test suite can fake GitHub locally (same prefix family as
# GIT_CREDENTIAL_KLANGK_DEBUG).
GITHUB_URL = os.environ.get(
    "GIT_CREDENTIAL_KLANGK_GITHUB_URL", "https://github.com"
).rstrip("/")
DEBUG = os.environ.get("GIT_CREDENTIAL_KLANGK_DEBUG", "")


def _debug(msg):
    if DEBUG:
        print(f"git-credential-klangk: {msg}", file=sys.stderr)


# Credential/response keys whose values must never appear in debug output.
_SENSITIVE_KEYS = {"password", "token", "access_token", "secret"}


def _redact(obj):
    """Return a copy of ``obj`` with sensitive values masked for debug logs.

    Applied to anything passed to ``_debug`` so a debug run can't leak a
    credential that was in the bridge response or the git credential input.
    """
    if isinstance(obj, dict):
        return {
            k: "***" if k.lower() in _SENSITIVE_KEYS else _redact(v)
            for k, v in obj.items()
        }
    if isinstance(obj, list):
        return [_redact(v) for v in obj]
    return obj


def _normalize_host(host):
    """Normalize a git credential ``host`` for provider matching.

    Git preserves case in the credential ``host`` field and can include an
    explicit port or a trailing dot (``GitHub.com``, ``github.com:443``,
    ``github.com.``). Normalize all of that away so every spelling of a
    remote's host reaches its provider.
    """
    normalized = (host or "").lower()
    port = normalized.find(":")
    if port >= 0:
        normalized = normalized[:port]
    return normalized.rstrip(".")


def _provider_entry(entry):
    """Validate one provider-map entry. Returns a provider dict or None.

    Required fields: ``host``, ``client_id``, ``device_code_url``,
    ``token_url``. Optional: ``scope`` (omitted from the code request when
    empty), ``username`` (the git username reported with the token;
    defaults to ``oauth2``, the convention GitLab and Gitea expect).
    """
    host = _normalize_host(str(entry.get("host", "")))
    client_id = str(entry.get("client_id", "")).strip()
    device_code_url = str(entry.get("device_code_url", "")).strip()
    token_url = str(entry.get("token_url", "")).strip()
    if not (host and client_id and device_code_url and token_url):
        return None
    return {
        "host": host,
        "client_id": client_id,
        "device_code_url": device_code_url,
        "token_url": token_url,
        "scope": str(entry.get("scope", "")).strip(),
        "username": str(entry.get("username", "")).strip() or "oauth2",
    }


def _load_provider_map():
    """Parse KLANGKWS_FEATURE_OAUTH_PROVIDERS into {host: provider}.

    An entry for ``example.com`` also matches a ``www.example.com``
    credential host (a www subdomain is typically the same site — mirrors
    the legacy github.com/www.github.com pair). Malformed JSON or a
    non-list value disables the whole map (debug-logged); individual bad
    entries are skipped.
    """
    raw = os.environ.get(PROVIDERS_ENV, "").strip()
    if not raw:
        return {}
    try:
        entries = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        _debug(f"{PROVIDERS_ENV}: invalid JSON, ignoring")
        return {}
    if not isinstance(entries, list):
        _debug(f"{PROVIDERS_ENV}: not a JSON list, ignoring")
        return {}
    providers = {}
    for entry in entries:
        if not isinstance(entry, dict):
            _debug(f"{PROVIDERS_ENV}: skipping non-object entry")
            continue
        provider = _provider_entry(entry)
        if provider is None:
            _debug(
                f"{PROVIDERS_ENV}: skipping entry missing "
                "host/client_id/device_code_url/token_url"
            )
            continue
        providers[provider["host"]] = provider
        if not provider["host"].startswith("www."):
            providers.setdefault(f"www.{provider['host']}", provider)
    return providers


def _github_shorthand_provider():
    """Expand the legacy client-ID env var into a GitHub provider entry."""
    client_id = os.environ.get(GITHUB_CLIENT_ID_ENV, "").strip()
    if not client_id:
        return None
    return {
        "host": "github.com",
        "client_id": client_id,
        "device_code_url": f"{GITHUB_URL}/login/device/code",
        "token_url": f"{GITHUB_URL}/login/oauth/access_token",
        "scope": "repo",
        "username": "x-access-token",
    }


def provider_for_host(host):
    """Return the OAuth device-flow provider configured for *host*, or None.

    An explicit KLANGKWS_FEATURE_OAUTH_PROVIDERS entry wins; the legacy
    KLANGKWS_FEATURE_GITHUB_OAUTH_CLIENT_ID shorthand is the fallback for
    github.com hosts. Mirrors ``_CredentialDialog.isGitHubHost`` in the
    browser-side feature for host normalization.
    """
    normalized = _normalize_host(host)
    if not normalized:
        return None
    providers = _load_provider_map()
    if normalized in providers:
        return providers[normalized]
    shorthand = _github_shorthand_provider()
    if shorthand and normalized in ("github.com", "www.github.com"):
        return shorthand
    return None


def _get_workspace_token():
    """Read the current workspace token via klangk-workspace-token."""
    try:
        result = subprocess.run(
            ["klangk-workspace-token"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def _get_browser_id():
    """Read the current browser ID via klangk-browser-id."""
    try:
        result = subprocess.run(
            ["klangk-browser-id"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def read_credential_input():
    """Read git credential protocol from stdin (key=value lines)."""
    cred = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        if "=" in line:
            key, value = line.split("=", 1)
            cred[key] = value
    return cred


def post_bridge(operation, cred, browser_id, timeout=None, extra=None):
    """POST to the browser-delegate bridge. Returns parsed JSON or None."""
    if timeout is None:
        timeout = TIMEOUT
    payload = {
        "action": "git_credential",
        "browser_id": browser_id,
        "operation": operation,
        "protocol": cred.get("protocol", ""),
        "host": cred.get("host", ""),
    }
    if cred.get("path"):
        payload["path"] = cred["path"]
    if cred.get("username"):
        payload["username"] = cred["username"]
    if cred.get("password"):
        payload["password"] = cred["password"]
    if extra:
        payload.update(extra)

    data = json.dumps(payload).encode()
    headers = {"Content-Type": "application/json"}
    workspace_token = _get_workspace_token()
    if workspace_token:
        headers["Authorization"] = f"Bearer {workspace_token}"

    req = urllib.request.Request(
        f"{BRIDGE_URL}/api/v1/browser-delegate",
        data=data,
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
            parsed = json.loads(body)
            _debug(f"bridge response: {json.dumps(_redact(parsed))[:500]}")
            return parsed
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"bridge error: {e}")
        return None


def _unwrap_bridge_response(resp):
    """Unwrap the bridge's {"status": "ok", "result": ...} envelope.

    The bridge wraps feature responses as {"status": "ok", "result":
    "<json-string>"}; return the inner dict when wrapped, the original
    response otherwise (also on an unwrappable result).
    """
    result = resp.get("result")
    if isinstance(result, str):
        try:
            return json.loads(result)
        except (json.JSONDecodeError, ValueError):
            pass
    return resp


def _peek_bridge_cache(cred, browser_id):
    """Return cached (username, password) from the browser, or None.

    Consults the tab's credential cache without triggering any UI: a
    device-flow login should only start when the cache is empty. The cache
    is populated by git's "store" call after a successful authenticated
    operation, so this turns one login into one per tab session.
    """
    resp = post_bridge("peek", cred, browser_id)
    if not resp:
        return None
    resp = _unwrap_bridge_response(resp)
    username = resp.get("username", "")
    password = resp.get("password", "")
    if username and password:
        return (username, password)
    return None


def _request_device_code(provider):
    """Request a device code from the provider. Returns parsed JSON or None."""
    params = {"client_id": provider["client_id"]}
    if provider["scope"]:
        params["scope"] = provider["scope"]
    data = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(
        provider["device_code_url"],
        data=data,
        headers={"Accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"device code request error: {e}")
        return None


def _poll_token(provider, device_code):
    """Poll the provider for the access token. Returns parsed JSON or None."""
    data = urllib.parse.urlencode(
        {
            "client_id": provider["client_id"],
            "device_code": device_code,
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        }
    ).encode()
    req = urllib.request.Request(
        provider["token_url"],
        data=data,
        headers={"Accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"token poll error: {e}")
        return None


def _handle_device_flow(cred, browser_id, provider):
    """Run the provider's OAuth device flow. Returns (username, password)
    or None."""
    _debug(f"starting device flow for {provider['host']}")

    code_resp = _request_device_code(provider)
    if not code_resp or "device_code" not in code_resp:
        error = code_resp.get("error_description", "") if code_resp else ""
        _debug(f"device code request failed: {error}")
        return None

    device_code = code_resp["device_code"]
    user_code = code_resp["user_code"]
    verification_uri = code_resp["verification_uri"]
    interval = code_resp.get("interval", 5)
    expires_in = code_resp.get("expires_in", 900)

    _debug(f"got device code, user_code={user_code} uri={verification_uri}")

    # Tell the browser to show the code and open the verification page.
    post_bridge(
        "device_flow_show",
        cred,
        browser_id,
        extra={
            "user_code": user_code,
            "verification_uri": verification_uri,
            # The provider's host (normalized) so the dialog can say which
            # service the code belongs to.
            "host": provider["host"],
        },
    )

    # Poll the provider for the token. The error vocabulary
    # (authorization_pending / slow_down / expired_token / access_denied)
    # is RFC 8628 standard, so the loop works for any compliant provider.
    deadline = time.monotonic() + expires_in
    while time.monotonic() < deadline:
        time.sleep(interval)

        resp = _poll_token(provider, device_code)
        if not resp:
            continue

        error = resp.get("error")
        if error is None:
            token = resp.get("access_token")
            if token:
                _debug("device flow: got token")
                # Tell browser to dismiss the code UI.
                done_resp = post_bridge("device_flow_done", cred, browser_id)
                _debug(f"device_flow_done response: {_redact(done_resp)}")
                return (provider["username"], token)

        if error == "authorization_pending":
            continue
        elif error == "slow_down":
            interval += 5
            _debug(f"device flow: slow_down, interval now {interval}s")
            continue
        elif error == "expired_token":
            _debug("device flow: code expired")
            post_bridge(
                "device_flow_error",
                cred,
                browser_id,
                extra={"error": "Code expired. Please try again."},
            )
            return None
        elif error == "access_denied":
            _debug("device flow: access denied")
            post_bridge(
                "device_flow_error",
                cred,
                browser_id,
                extra={"error": "Authorization denied."},
            )
            return None
        else:
            desc = resp.get("error_description", error)
            _debug(f"device flow: unexpected error: {desc}")
            post_bridge(
                "device_flow_error",
                cred,
                browser_id,
                extra={"error": desc},
            )
            return None

    _debug("device flow: timed out")
    post_bridge(
        "device_flow_error",
        cred,
        browser_id,
        extra={"error": "Code expired. Please try again."},
    )
    return None


def main():
    operation = sys.argv[1] if len(sys.argv) > 1 else ""

    browser_id = _get_browser_id()
    _debug(
        f"operation={operation} BRIDGE_URL={BRIDGE_URL!r} "
        f"BROWSER_ID={browser_id[:8] + '...' if browser_id else '(empty)'}"
    )

    if not BRIDGE_URL or not browser_id:
        _debug("no bridge configured, exiting")
        sys.exit(1)

    cred = read_credential_input()
    _debug(f"cred input: {_redact(cred)}")

    if operation == "get":
        # Try the OAuth device flow first when a provider is configured
        # for the host — but only after checking the tab's cache: git
        # calls "store" after a successful push, so a cached token must be
        # reused instead of forcing a fresh device-flow login on every
        # operation.
        provider = provider_for_host(cred.get("host", ""))
        if provider:
            cached = _peek_bridge_cache(cred, browser_id)
            if cached:
                _debug("using cached credential from browser")
                print(f"username={cached[0]}")
                print(f"password={cached[1]}")
                return
            result = _handle_device_flow(cred, browser_id, provider)
            if result:
                print(f"username={result[0]}")
                print(f"password={result[1]}")
                return

        # Fall back to PAT dialog via bridge.
        resp = post_bridge("get", cred, browser_id, timeout=GET_TIMEOUT)
        if not resp:
            sys.exit(1)

        resp = _unwrap_bridge_response(resp)

        username = resp.get("username", "")
        password = resp.get("password", "")
        if not username or not password:
            sys.exit(1)

        print(f"username={username}")
        print(f"password={password}")

    elif operation in ("store", "erase"):
        post_bridge(operation, cred, browser_id)

    # Unknown operations: exit silently.


if __name__ == "__main__":
    main()
