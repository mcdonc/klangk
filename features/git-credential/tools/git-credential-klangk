#!/usr/bin/env python3
"""Git credential helper that delegates to the user's browser.

Called by git as: git-credential-klangk get|store|erase

On "get": reads protocol/host/path (and, on git >= 2.46, the server's
WWW-Authenticate challenges as wwwauth[] lines) from stdin. If an OAuth
provider is configured for the host (a KLANGKWS_FEATURE_OAUTH_PROVIDERS
entry, or the legacy KLANGKWS_FEATURE_GITHUB_OAUTH_CLIENT_ID shorthand
for github.com), picks the flow the host actually supports -- from the
host's OIDC discovery document, with the entry's ``flow`` field and the
wwwauth realm as fallbacks -- and runs it: the RFC 8628 device flow, or
the authorization_code + PKCE (S256) browser flow for hosts like Gitea
that implement no device flow. Otherwise, or on fallback, delegates to
the browser for a PAT dialog.
On "store"/"erase": forwards to the bridge so the frontend can update or
clear its credential cache.

Falls through (exit 1) when the bridge is unreachable or the user
cancels, letting git try the next configured helper or prompt.
"""

import base64
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

BRIDGE_URL = os.environ.get("KLANGKWS_BRIDGE_URL", "")
TIMEOUT = 30
# Device flow codes expire after 15 minutes; the credential get operation
# may block on user interaction (PAT dialog or device flow), so use a much
# longer timeout than the default bridge timeout.
GET_TIMEOUT = 900
# Provider map: JSON list of per-host OAuth device-flow configs. See
# _provider_entry for the entry shape.
PROVIDERS_ENV = "KLANGKWS_FEATURE_OAUTH_PROVIDERS"
# Stock provider shorthands: a bare OAuth client ID in one of these env
# vars expands to that public instance's stock device-flow entry (see
# STOCK_PROVIDERS below). A self-hosted instance of the same software
# lives at its own host — configure those (and any other RFC 8628
# provider) via the provider map.
GITHUB_CLIENT_ID_ENV = "KLANGKWS_FEATURE_GITHUB_OAUTH_CLIENT_ID"
GITLAB_CLIENT_ID_ENV = "KLANGKWS_FEATURE_GITLAB_OAUTH_CLIENT_ID"
# Device-flow base URLs for the stock shorthands. Overridable so the test
# suite can fake the providers locally (same prefix family as
# GIT_CREDENTIAL_KLANGK_DEBUG).
GITHUB_URL = os.environ.get(
    "GIT_CREDENTIAL_KLANGK_GITHUB_URL", "https://github.com"
).rstrip("/")
GITLAB_URL = os.environ.get(
    "GIT_CREDENTIAL_KLANGK_GITLAB_URL", "https://gitlab.com"
).rstrip("/")
DEBUG = os.environ.get("GIT_CREDENTIAL_KLANGK_DEBUG", "")

# Provider flows: the device flow (RFC 8628) and the browser
# authorization-code flow with PKCE S256 (RFC 6749 + RFC 7636) for hosts
# like Gitea that implement no device flow in any release.
FLOW_DEVICE_CODE = "device_code"
FLOW_AUTH_CODE_PKCE = "authorization_code_pkce"
# OIDC discovery, fetched once per flow start; a slow host must never
# stall the clone (#3385).
DISCOVERY_TIMEOUT = 5
# PKCE code_verifier: 43-128 chars from the unreserved alphabet
# (RFC 7636 section 4.1); 64 is comfortably inside the range.
PKCE_VERIFIER_LEN = 64
UNRESERVED = (
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
)
# Refresh a token when it expires within this window (seconds) so a
# clone never races the token's death (#3385).
REFRESH_SKEW = 120

# The stock provider table: shorthand env var -> public-instance
# device-flow shape. GitLab's device grant needs GitLab 17.1+ with the
# flow enabled on the OAuth app. Gitea has no device flow in any release
# yet (go-gitea/gitea#27309) — self-hosted and other providers use the
# provider map.
STOCK_PROVIDERS = [
    {
        "env": GITHUB_CLIENT_ID_ENV,
        "host": "github.com",
        "device_code_path": "/login/device/code",
        "token_path": "/login/oauth/access_token",
        "scope": "repo",
        "username": "x-access-token",
        "base_url": GITHUB_URL,
    },
    {
        "env": GITLAB_CLIENT_ID_ENV,
        "host": "gitlab.com",
        "device_code_path": "/oauth/authorize_device",
        "token_path": "/oauth/token",
        "scope": "read_repository write_repository",
        "username": "oauth2",
        "base_url": GITLAB_URL,
    },
]


def _debug(msg):
    if DEBUG:
        print(f"git-credential-klangk: {msg}", file=sys.stderr)


# Credential/response keys whose values must never appear in debug output.
_SENSITIVE_KEYS = {
    "password",
    "token",
    "access_token",
    "refresh_token",
    "oauth_refresh_token",
    "secret",
}


def _redact_item(key, value):
    """One redacted dict entry: mask sensitive keys, recurse otherwise."""
    if key.lower() in _SENSITIVE_KEYS:
        return "***"
    return _redact(value)


def _redact(obj):
    """Return a copy of ``obj`` with sensitive values masked for debug logs.

    Applied to anything passed to ``_debug`` so a debug run can't leak a
    credential that was in the bridge response or the git credential input.
    """
    if isinstance(obj, dict):
        return {k: _redact_item(k, v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_redact(v) for v in obj]
    return obj


def _normalize_host(host):
    """Normalize a git credential ``host`` for provider matching.

    Git preserves case in the credential ``host`` field and can include an
    explicit port or a trailing dot (``GitHub.com``, ``github.com:443``,
    ``github.com.``). Normalize all of that away so every spelling of a
    remote's host reaches its provider.
    """
    normalized = (host or "").lower()
    port = normalized.find(":")
    if port >= 0:
        normalized = normalized[:port]
    return normalized.rstrip(".")


def _device_entry_fields(entry, provider):
    """Fill the device-flow fields; False when the entry is incomplete."""
    device_code_url = str(entry.get("device_code_url", "")).strip()
    if not device_code_url:
        return False
    provider["device_code_url"] = device_code_url
    return True


def _pkce_entry_fields(entry, provider):
    """Fill the PKCE fields; False when the entry is incomplete."""
    authorize_url = str(entry.get("authorize_url", "")).strip()
    redirect_uri = str(entry.get("redirect_uri", "")).strip()
    if not (authorize_url and redirect_uri):
        return False
    provider["authorize_url"] = authorize_url
    provider["redirect_uri"] = redirect_uri
    return True


_ENTRY_FIELDS = {
    FLOW_DEVICE_CODE: _device_entry_fields,
    FLOW_AUTH_CODE_PKCE: _pkce_entry_fields,
}


def _entry_basics(entry):
    """The trimmed common fields of a provider-map entry."""
    host = _normalize_host(str(entry.get("host", "")))
    client_id = str(entry.get("client_id", "")).strip()
    token_url = str(entry.get("token_url", "")).strip()
    flow = str(entry.get("flow", FLOW_DEVICE_CODE)).strip() or FLOW_DEVICE_CODE
    return host, client_id, token_url, flow


def _valid_basics(host, client_id, token_url, flow):
    """True when the common fields are present and the flow is known."""
    return bool(host and client_id and token_url and flow in _ENTRY_FIELDS)


def _provider_entry(entry):
    """Validate one provider-map entry. Returns a provider dict or None.

    Required fields: ``host``, ``client_id``, ``token_url`` and the
    per-flow fields -- ``device_code_url`` for the device flow,
    ``authorize_url`` + ``redirect_uri`` for authorization_code_pkce.
    ``flow`` defaults to ``device_code``. Optional: ``scope`` (omitted
    from requests when empty), ``username`` (the git username reported
    with the token; defaults to ``oauth2``, the convention GitLab and
    Gitea expect).
    """
    host, client_id, token_url, flow = _entry_basics(entry)
    if not _valid_basics(host, client_id, token_url, flow):
        return None
    provider = {
        "host": host,
        "client_id": client_id,
        "token_url": token_url,
        "flow": flow,
        "scope": str(entry.get("scope", "")).strip(),
        "username": str(entry.get("username", "")).strip() or "oauth2",
    }
    if not _ENTRY_FIELDS[flow](entry, provider):
        return None
    return provider


def _map_entries(entries):
    """Validate a parsed JSON list into {host: provider}, skipping bad
    entries with a debug note."""
    providers = {}
    for entry in entries:
        if not isinstance(entry, dict):
            _debug(f"{PROVIDERS_ENV}: skipping non-object entry")
            continue
        provider = _provider_entry(entry)
        if provider is None:
            _debug(
                f"{PROVIDERS_ENV}: skipping entry missing "
                "host/client_id/token_url or its per-flow fields"
            )
            continue
        providers[provider["host"]] = provider
    return providers


def _load_provider_map():
    """Parse KLANGKWS_FEATURE_OAUTH_PROVIDERS into {host: provider}.

    Malformed JSON or a non-list value disables the whole map
    (debug-logged); individual bad entries are skipped. ``www.`` matching
    is handled at lookup time (see :func:`provider_for_host`).
    """
    raw = os.environ.get(PROVIDERS_ENV, "").strip()
    if not raw:
        return {}
    try:
        entries = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        _debug(f"{PROVIDERS_ENV}: invalid JSON, ignoring")
        return {}
    if not isinstance(entries, list):
        _debug(f"{PROVIDERS_ENV}: not a JSON list, ignoring")
        return {}
    return _map_entries(entries)


def _stock_providers():
    """Expand the per-provider client-ID shorthands into provider entries.

    Each STOCK_PROVIDERS env var holding a bare client ID becomes the
    stock entry for its public instance (endpoints derived from the
    instance's base URL, overridable for tests).
    """
    providers = {}
    for spec in STOCK_PROVIDERS:
        client_id = os.environ.get(spec["env"], "").strip()
        if not client_id:
            continue
        base = spec["base_url"]
        providers[spec["host"]] = {
            "host": spec["host"],
            "client_id": client_id,
            "flow": FLOW_DEVICE_CODE,
            "device_code_url": f"{base}{spec['device_code_path']}",
            "token_url": f"{base}{spec['token_path']}",
            "scope": spec["scope"],
            "username": spec["username"],
        }
    return providers


def provider_for_host(host):
    """Return the OAuth device-flow provider configured for *host*, or None.

    An explicit KLANGKWS_FEATURE_OAUTH_PROVIDERS entry wins; the stock
    per-instance shorthands (GitHub, GitLab) are the fallback for their
    hosts. The credential host is normalized (case, port, trailing dot)
    and may carry a ``www.`` prefix — entries must be the bare host.
    Mirrors ``_CredentialDialog.isGitHubHost`` in the browser-side
    feature for host normalization.
    """
    normalized = _normalize_host(host)
    if not normalized:
        return None
    providers = _stock_providers()
    providers.update(_load_provider_map())
    if normalized in providers:
        return providers[normalized]
    if normalized.startswith("www."):
        return providers.get(normalized.removeprefix("www."))
    return None


def _get_workspace_token():
    """Read the current workspace token via klangk-workspace-token."""
    try:
        result = subprocess.run(
            ["klangk-workspace-token"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def _get_browser_id():
    """Read the current browser ID via klangk-browser-id."""
    try:
        result = subprocess.run(
            ["klangk-browser-id"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def _parse_input_line(line):
    """(key, value, stop) for one stdin line; key is None for a line
    with no separator."""
    stripped = line.strip()
    if not stripped:
        return None, None, True
    if "=" not in stripped:
        return None, None, False
    key, value = stripped.split("=", 1)
    return key, value, False


def _absorb_line(cred, wwwauth, line):
    """Fold one stdin line into the credential input; False ends it."""
    key, value, stop = _parse_input_line(line)
    if stop:
        return False
    if key is None:
        return True
    if key == "wwwauth[]":
        wwwauth.append(value)
    else:
        cred[key] = value
    return True


def read_credential_input():
    """Read git credential protocol from stdin (key=value lines).

    The server's WWW-Authenticate challenges arrive as repeated
    ``wwwauth[]=...`` lines (git >= 2.46); every other key is last-wins,
    but the challenges are collected into a ``wwwauth`` list.
    """
    cred = {}
    wwwauth = []
    for line in sys.stdin:
        if not _absorb_line(cred, wwwauth, line):
            break
    if wwwauth:
        cred["wwwauth"] = wwwauth
    return cred


def wwwauth_realms(cred):
    """Lowercased realm values from the input's WWW-Authenticate
    challenges, e.g. ['gitea'] for wwwauth[]=Basic realm="Gitea".

    RFC 7235 parameter names are case-insensitive and realm values may
    be double-quoted, single-quoted, or bare tokens."""
    pattern = re.compile(
        r"realm=(?:\"([^\"]*)\"|'([^']*)'|([^\s,]+))", re.IGNORECASE
    )
    realms = []
    for challenge in cred.get("wwwauth", []):
        match = pattern.search(challenge)
        if match:
            # exactly one alternative participated (an empty quoted realm
            # is a match, not a fall-through)
            value = next(g for g in match.groups() if g is not None)
            realms.append(value.lower())
    return realms


def is_gitea_family(cred):
    """True when the host names itself Gitea/Forgejo via a challenge.

    Gitea answers git smart-HTTP with ``Basic realm="Gitea"`` (Forgejo
    kept the realm), and implements no device flow in any release -- a
    device-flow entry for such a host is stale, and the helper says so
    instead of running a flow that can only fail.
    """
    realms = wwwauth_realms(cred)
    return any("gitea" in realm or "forgejo" in realm for realm in realms)


def discovery_document(provider):
    """Fetch the provider instance's OIDC discovery document, or None.

    Fetched from the origin the entry's ``token_url`` names -- the same
    server the flow talks to -- once per flow start with a short timeout
    (#3385): the document names the grant the server actually implements.
    """
    parts = urllib.parse.urlsplit(provider["token_url"])
    if not parts.scheme or not parts.netloc:
        return None
    url = f"{parts.scheme}://{parts.netloc}/.well-known/openid-configuration"
    try:
        with urllib.request.urlopen(url, timeout=DISCOVERY_TIMEOUT) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"discovery fetch error: {e}")
        return None


def _grant_list(doc):
    """grant_types_supported as a list — a non-list value (a stray
    string) would otherwise degrade `in` to substring matching."""
    grants = doc.get("grant_types_supported")
    return grants if isinstance(grants, list) else []


def _method_list(doc):
    """code_challenge_methods_supported as a list."""
    methods = doc.get("code_challenge_methods_supported")
    return methods if isinstance(methods, list) else []


def _device_grant_supported(doc):
    """True when the document advertises the device grant. GitLab lists
    the grant in ``grant_types_supported`` without a
    ``device_authorization_endpoint`` — that key is an OIDC extension,
    not a standardized field, so both spellings count (#3385)."""
    grants = _grant_list(doc)
    device_grants = (
        "device_code",
        "urn:ietf:params:oauth:grant-type:device_code",
    )
    return any(grant in grants for grant in device_grants)


def _supports_auth_code_pkce(doc):
    """True when the document advertises the authorization_code grant
    with the S256 challenge method."""
    return "authorization_code" in _grant_list(doc) and "S256" in _method_list(doc)


def flow_from_discovery(doc):
    """Map a discovery document to a flow constant, or None when the
    host advertises neither grant. A document advertising both grants
    (GitLab) takes the device flow — it is the flow that needs no
    browser relay."""
    if not isinstance(doc, dict):
        return None
    if doc.get("device_authorization_endpoint") or _device_grant_supported(doc):
        return FLOW_DEVICE_CODE
    if _supports_auth_code_pkce(doc):
        return FLOW_AUTH_CODE_PKCE
    return None


def _document_matches_entry(doc, provider):
    """True when the document describes the entry's own server: its
    token endpoint names the token URL the entry configured. For a
    path-prefixed provider (``https://corp.example.com/gitea``) the bare
    origin's document belongs to whatever app owns the outer origin and
    must not override the operator's configured flow."""
    return doc.get("token_endpoint") == provider["token_url"]


def _flow_from_document(provider):
    """(flow, outcome) from the discovery document; outcome is one of
    "doc" (flow resolved), "no-doc" (unreachable or foreign) or
    "neither"."""
    doc = discovery_document(provider)
    if doc is None or not _document_matches_entry(doc, provider):
        return None, "no-doc"
    flow = flow_from_discovery(doc)
    if flow is None:
        return None, "neither"
    if flow != provider["flow"]:
        _debug(
            f"entry flow {provider['flow']} is stale; "
            f"discovery says {flow}"
        )
    return flow, "doc"


def _entry_flow_fallback(cred, provider):
    """The flow when no document answered: the entry's own ``flow`` --
    unless the host challenges as Gitea/Forgejo against a device entry."""
    _debug("discovery unavailable; using the entry's flow")
    if provider["flow"] == FLOW_DEVICE_CODE and is_gitea_family(cred):
        _debug("host identifies as Gitea/Forgejo; it has no device flow")
        return None
    return provider["flow"]


def select_flow(cred, provider):
    """Pick the flow for a configured provider, or None for the PAT
    dialog fallback (#3385).

    The discovery document wins -- it describes what the server
    implements; an entry whose ``flow`` disagrees is stale and logged as
    such. Without a document the entry's ``flow`` stands, except that a
    host identifying as Gitea/Forgejo via its WWW-Authenticate challenge
    cannot run the device flow.
    """
    flow, outcome = _flow_from_document(provider)
    if outcome == "no-doc":
        return _entry_flow_fallback(cred, provider)
    if outcome == "neither":
        _debug("discovery advertises neither grant; using PAT dialog")
        return None
    return flow


def s256_challenge(verifier):
    """The S256 code_challenge for a verifier (RFC 7636 section 4.2)."""
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    return base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")


def make_pkce_pair():
    """A fresh (code_verifier, code_challenge) pair. The verifier lives
    only inside this helper process for the duration of one flow."""
    verifier = "".join(
        secrets.choice(UNRESERVED) for _ in range(PKCE_VERIFIER_LEN)
    )
    return verifier, s256_challenge(verifier)


def authorize_url(provider, code_challenge, state):
    """The authorization endpoint URL for one flow attempt."""
    params = {
        "response_type": "code",
        "client_id": provider["client_id"],
        "redirect_uri": provider["redirect_uri"],
        "code_challenge": code_challenge,
        "code_challenge_method": "S256",
        "state": state,
    }
    if provider["scope"]:
        params["scope"] = provider["scope"]
    separator = "&" if "?" in provider["authorize_url"] else "?"
    return f"{provider['authorize_url']}{separator}{urllib.parse.urlencode(params)}"


def _token_expiry(token_resp):
    """Absolute expiry (epoch seconds) for a token response, or 0."""
    expires_in = _as_int(token_resp.get("expires_in"), 0)
    return int(time.time()) + expires_in if expires_in > 0 else 0


def _store_flow_credential(cred, browser_id, provider, token_resp):
    """Cache the OAuth credential (with its refresh token) in the tab.

    The helper stores it immediately: git's own later "store" call
    carries only username/password (it never sees the refresh token),
    and the helper process does not outlive the operation.
    """
    password = token_resp.get("access_token", "")
    if not password:
        return
    extra = {
        "username": provider["username"],
        "password": password,
    }
    # Omit absent refresh fields: the tab merges (git's own store keeps
    # old values), and empty strings would clobber a good refresh token.
    if token_resp.get("refresh_token"):
        extra["refresh_token"] = token_resp["refresh_token"]
    expiry = _token_expiry(token_resp)
    if expiry:
        extra["expires_at"] = expiry
    post_bridge("store", cred, browser_id, extra=extra)


def _cache_expires_soon(cached):
    """True when the cached credential expires inside the skew window."""
    expires_at = _as_int(cached.get("expires_at"), 0)
    return expires_at > 0 and expires_at - time.time() <= REFRESH_SKEW


def _refresh_cached(cred, browser_id, provider, cached):
    """(username, password, token-response) from a headless refresh.

    Returns None both when no refresh is due and when one was attempted
    and rejected — the caller distinguishes the two via
    :func:`_cache_expires_soon` and runs a fresh flow for the rejected
    case instead of serving a possibly-dead token.
    """
    refresh = cached.get("refresh_token")
    if not refresh or not _cache_expires_soon(cached):
        return None
    _debug(f"cached token for {provider['host']} is expiring; refreshing")
    token_resp = refresh_access_token(provider, refresh)
    if not isinstance(token_resp, dict) or not token_resp.get("access_token"):
        _debug("refresh rejected; dropping the cached credential")
        post_bridge("erase", cred, browser_id)
        return None
    _store_flow_credential(cred, browser_id, provider, token_resp)
    return (provider["username"], token_resp["access_token"], token_resp)


def _handle_auth_code_flow(cred, browser_id, provider):
    """Run the browser authorization-code flow (#3385): open the authorize
    popup through the bridge, receive the code from the callback page,
    exchange it container-side. Returns (username, password,
    token-response) or None."""
    verifier, challenge = make_pkce_pair()
    state = secrets.token_urlsafe(32)
    url = authorize_url(provider, challenge, state)
    resp = post_bridge(
        "auth_flow_start",
        cred,
        browser_id,
        timeout=GET_TIMEOUT,
        extra={"authorize_url": url, "state": state, "host": provider["host"]},
    )
    if not resp:
        _debug("authorization flow: no answer from the browser")
        return None
    return _finish_auth_code_flow(cred, browser_id, provider, verifier, state, resp)


def _finish_auth_code_flow(cred, browser_id, provider, verifier, state, resp):
    """Validate the browser's answer and exchange the code."""
    resp = _unwrap_bridge_response(resp)
    if resp.get("error"):
        _debug(f"authorization flow: {resp['error']}")
        return None
    if resp.get("state") != state:
        _debug("authorization flow: state mismatch, discarding")
        return None
    token_resp = exchange_code(provider, resp.get("code", ""), verifier)
    if not isinstance(token_resp, dict) or not token_resp.get("access_token"):
        _debug("authorization flow: code exchange failed")
        return None
    _store_flow_credential(cred, browser_id, provider, token_resp)
    return (provider["username"], token_resp["access_token"], token_resp)


def _post_form(url, params):
    """POST urlencoded params accepting JSON. Parsed JSON or None."""
    data = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(
        url, data=data, headers={"Accept": "application/json"}, method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"token endpoint error ({url}): {e}")
        return None


def exchange_code(provider, code, code_verifier):
    """Exchange an authorization code for tokens (public client: no
    secret, the verifier carries the proof). Returns parsed JSON or
    None."""
    return _post_form(
        provider["token_url"],
        {
            "grant_type": "authorization_code",
            "code": code,
            "code_verifier": code_verifier,
            "client_id": provider["client_id"],
            "redirect_uri": provider["redirect_uri"],
        },
    )


def refresh_access_token(provider, refresh_token):
    """Refresh an access token headlessly (no browser involved).
    Returns parsed JSON or None."""
    return _post_form(
        provider["token_url"],
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
            "client_id": provider["client_id"],
        },
    )


def credential_output(username, password, token_resp=None):
    """The git-credential protocol output for one credential.

    ``oauth_refresh_token`` and ``password_expiry_utc`` ride along when
    the provider supplied them: git >= 2.46 uses both (refresh hint,
    expiry-driven erase); older git ignores unknown attributes, so they
    are emitted without version detection (#3385).
    """
    lines = [f"username={username}", f"password={password}"]
    if isinstance(token_resp, dict):
        refresh = token_resp.get("refresh_token")
        expires_in = _as_int(token_resp.get("expires_in"), 0)
        if refresh:
            lines.append(f"oauth_refresh_token={refresh}")
        if expires_in > 0:
            lines.append(f"password_expiry_utc={int(time.time()) + expires_in}")
    return "\n".join(lines)


def _bridge_payload(operation, cred, browser_id, extra):
    """The bridge request body for one credential operation."""
    payload = {
        "action": "git_credential",
        "browser_id": browser_id,
        "operation": operation,
        "protocol": cred.get("protocol", ""),
        "host": cred.get("host", ""),
    }
    for key in ("path", "username", "password"):
        if cred.get(key):
            payload[key] = cred[key]
    if extra:
        payload.update(extra)
    return payload


def _bridge_headers():
    """Request headers incl. the workspace token when one is present."""
    headers = {"Content-Type": "application/json"}
    workspace_token = _get_workspace_token()
    if workspace_token:
        headers["Authorization"] = f"Bearer {workspace_token}"
    return headers


def post_bridge(operation, cred, browser_id, timeout=None, extra=None):
    """POST to the browser-delegate bridge. Returns parsed JSON or None."""
    if timeout is None:
        timeout = TIMEOUT
    data = json.dumps(
        _bridge_payload(operation, cred, browser_id, extra)
    ).encode()
    req = urllib.request.Request(
        f"{BRIDGE_URL}/api/v1/browser-delegate",
        data=data,
        headers=_bridge_headers(),
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
            parsed = json.loads(body)
            _debug(f"bridge response: {json.dumps(_redact(parsed))[:500]}")
            return parsed
    except (urllib.error.URLError, OSError, json.JSONDecodeError, ValueError) as e:
        _debug(f"bridge error: {e}")
        return None


def _unwrap_bridge_response(resp):
    """Unwrap the bridge's {"status": "ok", "result": ...} envelope.

    The bridge wraps feature responses as {"status": "ok", "result":
    "<json-string>"}; return the inner dict when wrapped, the original
    response otherwise (also on an unwrappable result).
    """
    result = resp.get("result")
    if isinstance(result, str):
        try:
            return json.loads(result)
        except (json.JSONDecodeError, ValueError):
            pass
    return resp


def _peek_bridge_cache(cred, browser_id):
    """The tab's cached credential entry (a dict with username/password,
    plus refresh fields for OAuth tokens), or None.

    Consults the tab's credential cache without triggering any UI: a
    flow should only start when the cache is empty. The cache is
    populated by git's "store" call after a successful authenticated
    operation, so this turns one login into one per tab session.
    """
    resp = post_bridge("peek", cred, browser_id)
    if not resp:
        return None
    resp = _unwrap_bridge_response(resp)
    username = resp.get("username", "")
    password = resp.get("password", "")
    if username and password:
        return resp
    return None


def _request_device_code(provider):
    """Request a device code from the provider. Returns parsed JSON or None."""
    params = {"client_id": provider["client_id"]}
    if provider["scope"]:
        params["scope"] = provider["scope"]
    return _post_form(provider["device_code_url"], params)


def _poll_token(provider, device_code):
    """Poll the provider for the access token. Returns parsed JSON or None."""
    return _post_form(
        provider["token_url"],
        {
            "client_id": provider["client_id"],
            "device_code": device_code,
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        },
    )


def _as_int(value, default):
    """Coerce a provider-supplied number, tolerating strings/garbage."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def _device_code_response(resp):
    """Shape-check a device-code response. Returns the dict or None.

    A provider answering 200 with a partial or non-object body must not
    crash the helper mid-flow — the dialog would hang with no error.
    """
    if not isinstance(resp, dict):
        return None
    if not all(
        k in resp for k in ("device_code", "user_code", "verification_uri")
    ):
        return None
    return resp


def _handle_device_flow(cred, browser_id, provider):
    """Run the provider's OAuth device flow. Returns (username,
    password, token-response) or None."""
    _debug(f"starting device flow for {provider['host']}")

    code_resp = _device_code_response(_request_device_code(provider))
    if not code_resp:
        _debug("device code request failed or returned a malformed body")
        return None

    device_code = code_resp["device_code"]
    user_code = code_resp["user_code"]
    verification_uri = code_resp["verification_uri"]
    # Floor the interval at 1s — a provider sending 0 must not busy-poll
    # the token endpoint (RFC 8628 section 3.5 default is 5).
    interval = max(_as_int(code_resp.get("interval"), 5), 1)
    expires_in = max(_as_int(code_resp.get("expires_in"), 900), 1)

    _debug(f"got device code, user_code={user_code} uri={verification_uri}")

    # Tell the browser to show the code and open the verification page.
    post_bridge(
        "device_flow_show",
        cred,
        browser_id,
        extra={
            "user_code": user_code,
            "verification_uri": verification_uri,
            # The provider's host (normalized) so the dialog can say which
            # service the code belongs to.
            "host": provider["host"],
        },
    )

    # Poll the provider for the token. A malformed provider response must
    # not crash the helper and strand the already-shown dialog — report
    # and fall back to the PAT path.
    try:
        return _poll_device_token(
            cred, browser_id, provider, device_code, interval, expires_in
        )
    except Exception as e:
        _debug(f"device flow: unexpected error: {e}")
        post_bridge(
            "device_flow_error",
            cred,
            browser_id,
            extra={
                "host": provider["host"],
                "error": "Device flow failed unexpectedly.",
            },
        )
        return None


def _poll_failure_step(resp, interval):
    """("wait", new-interval) or ("stop", the-response-so-the-caller-
    can-name the error)."""
    error = resp.get("error")
    if error == "authorization_pending":
        return "wait", interval
    if error == "slow_down":
        return "wait", interval + 5
    return "stop", resp


def _poll_step(provider, device_code, interval):
    """One token poll: ("token", response) | ("wait", interval) |
    ("stop", response). A response with neither token nor error stops
    the loop."""
    resp = _poll_token(provider, device_code)
    if not resp:
        return "wait", interval
    if resp.get("error") is None and resp.get("access_token"):
        return "token", resp
    return _poll_failure_step(resp, interval)


def _poll_error_text(resp):
    """The dialog text for a terminal poll error."""
    error = resp.get("error")
    if error == "expired_token":
        return "Code expired. Please try again."
    if error == "access_denied":
        return "Authorization denied."
    return resp.get("error_description", error)


def _post_poll_error(cred, browser_id, provider, error_text):
    """Show the failure dialog and log it (helper for the poll loop)."""
    _debug(f"device flow: {error_text}")
    post_bridge(
        "device_flow_error",
        cred,
        browser_id,
        extra={"host": provider["host"], "error": error_text},
    )


def _poll_device_token(
    cred, browser_id, provider, device_code, interval, expires_in
):
    """Poll the provider for the token (RFC 8628 section 3.5). The error
    vocabulary (authorization_pending / slow_down / expired_token /
    access_denied) is standard, so the loop works for any compliant
    provider. Returns (username, password, token-response) or None."""
    deadline = time.monotonic() + expires_in
    while time.monotonic() < deadline:
        time.sleep(interval)
        kind, value = _poll_step(provider, device_code, interval)
        if kind == "token":
            _debug("device flow: got token")
            # Tell browser to dismiss the code UI.
            done_resp = post_bridge("device_flow_done", cred, browser_id)
            _debug(f"device_flow_done response: {_redact(done_resp)}")
            return (provider["username"], value["access_token"], value)
        if kind == "stop":
            _post_poll_error(cred, browser_id, provider, _poll_error_text(value))
            return None
        interval = value
    _debug("device flow: timed out")
    _post_poll_error(
        cred, browser_id, provider, "Code expired. Please try again."
    )
    return None


def _log_startup(operation, browser_id):
    """One debug line naming the operation and bridge configuration."""
    shown = browser_id[:8] + "..." if browser_id else "(empty)"
    _debug(
        f"operation={operation} BRIDGE_URL={BRIDGE_URL!r} "
        f"BROWSER_ID={shown}"
    )


def _bridge_ready(browser_id):
    """False (with a debug note) when the bridge cannot be reached."""
    if not (BRIDGE_URL and browser_id):
        _debug("no bridge configured, exiting")
        return False
    return True


def _provider_get(cred, browser_id):
    """(username, password, token-response) from a configured provider
    — cache first (refreshing an expiring token headlessly, #3385), then
    the selected flow — or None when the helper must fall back to the
    PAT dialog.

    The tab cache is checked before any flow: git calls "store" after a
    successful push, so a cached token must be reused instead of forcing
    a fresh login on every operation.
    """
    provider = provider_for_host(cred.get("host", ""))
    if not provider:
        return None
    cached = _peek_bridge_cache(cred, browser_id)
    if cached:
        return _cached_get(cred, browser_id, provider, cached)
    return _flow_get(cred, browser_id, provider)


def _cached_get(cred, browser_id, provider, cached):
    """Serve a get from the tab cache: headless refresh when the token is
    inside the skew window; a fresh flow when the refresh was rejected;
    the cached credential otherwise."""
    refreshed = _refresh_cached(cred, browser_id, provider, cached)
    if refreshed:
        return refreshed
    if _cache_expires_soon(cached) and cached.get("refresh_token"):
        # The refresh was attempted and rejected; the cached token may
        # already be dead, so run a fresh flow instead of serving it
        # (#3385 review).
        return _flow_get(cred, browser_id, provider)
    _debug("using cached credential from browser")
    return cached["username"], cached["password"], None


def _entry_supports(provider, flow):
    """True when the entry carries the fields the flow needs. A trusted
    discovery document may name a flow the entry never configured (a
    device entry on a server that dropped the device grant, or a PKCE
    entry on one that gained it); such a flip answers with the PAT
    dialog, never a KeyError."""
    if flow == FLOW_DEVICE_CODE:
        return bool(provider.get("device_code_url"))
    return bool(provider.get("authorize_url") and provider.get("redirect_uri"))


def _flow_get(cred, browser_id, provider):
    """Run the selected flow for a configured provider."""
    flow = select_flow(cred, provider)
    if flow is None or not _entry_supports(provider, flow):
        if flow is not None:
            _debug(
                f"{flow} selected but the entry lacks its endpoints; "
                "using PAT dialog"
            )
        return None
    if flow == FLOW_DEVICE_CODE:
        return _handle_device_flow(cred, browser_id, provider)
    return _handle_auth_code_flow(cred, browser_id, provider)


def _pat_dialog_get(cred, browser_id):
    """(username, password, None) from the browser PAT dialog; exits 1
    on a failed or empty response so git tries its next helper."""
    resp = post_bridge("get", cred, browser_id, timeout=GET_TIMEOUT)
    if not resp:
        sys.exit(1)
    resp = _unwrap_bridge_response(resp)
    username = resp.get("username", "")
    password = resp.get("password", "")
    if not username or not password:
        sys.exit(1)
    return username, password, None


def _run_get(cred, browser_id):
    """Serve a get operation: provider flow or PAT dialog, then the
    git-credential protocol output."""
    result = _provider_get(cred, browser_id) or _pat_dialog_get(
        cred, browser_id
    )
    # stdout here is the git-credential protocol pipe to git, not a log;
    # an explicit write says so (and keeps the credential out of
    # logging-style sinks — CodeQL flags `print` of a password).
    sys.stdout.write(credential_output(result[0], result[1], result[2]) + "\n")


def main():
    operation = sys.argv[1] if len(sys.argv) > 1 else ""

    browser_id = _get_browser_id()
    _log_startup(operation, browser_id)

    if not _bridge_ready(browser_id):
        sys.exit(1)

    cred = read_credential_input()
    _debug(f"cred input: {_redact(cred)}")

    if operation == "get":
        _run_get(cred, browser_id)
    elif operation in ("store", "erase"):
        post_bridge(operation, cred, browser_id)

    # Unknown operations: exit silently.


if __name__ == "__main__":
    main()
