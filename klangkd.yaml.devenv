# Devenv-only config for klangkd. This is NOT a deployment template.
#
# devenv.nix copies it to klangkd.yaml (gitignored) on first shell entry, and
# the backend runs `klangkd --config klangkd.yaml`. The values below are
# devenv-specific (cmd:-indirected to $DEVENV_STATE / $DEVENV_ROOT) and will
# NOT work outside the devenv shell.
#
# For a real deployment, do not copy this file: run `klangkd` with no
# --config and it generates a deployment-suitable config at
# $KLANGKD_CONFIG_DIR/klangkd.yaml (default ~/.config/klangkd/klangkd.yaml)
# on first run (#1645, #1649). See docs/reference/klangkd-config.md.

# port: the browser/proxy port. Set it for full/browser mode (UI at
# http://localhost:8997). Leave unset for headless mode (no browser listener;
# container-egress only).
port: "8997"

# listen: the ingress interface IP address (used only when port is set).
listen: "127.0.0.1"

# container ingress port and container idle timeout seconds
egress_port: "8995"
idle_timeout_seconds: "300"

# #3157: the dev backend fronts the SPA, the CLI, and local scripting
# through one loopback IP — they'd all share a single 300/60s budget.
# Not a deployment template; keep local dev unlimited.
api_rate_limit: "0"

# "none", "password", "oidc", or "both" for UI (TUI/web) access
auth_modes: password

# --- Auth / identity ---
jwt_secret: secret-change-in-production
default_user: admin@example.com
default_password: admin123abc

# --- Storage ---
# state_dir/data_dir are required (no defaults, #1461). In dev these resolve
# via cmd: to devenv's paths ($DEVENV_STATE); in a real deployment set them
# here or via the env vars.
state_dir: "cmd:echo $DEVENV_STATE/klangk"
data_dir: "cmd:echo $DEVENV_STATE/klangk/data"

# The built Flutter web UI is served from here. In dev (editable source tree)
# the in-package default (klangk/frontend) doesn't exist, so point at the
# repo build output; an installed wheel leaves this unset for the in-package
# default (#1456, #1600).
frontend_dir: "cmd:echo $DEVENV_ROOT/src/frontend/build/web"

# --- Container / workspace ---
image_name: klangk-workspace

# --- Container resource limits (#34) ---
# Deploy-wide CPU / memory / PIDs caps applied to every workspace
# container (podman --cpus / --memory / --pids-limit). These are the
# built-in defaults (shown uncommented so they're discoverable, #2030); a
# fresh install is bounded at 2 CPUs / 8g / 512 PIDs so a runaway
# workspace can't take down the host. A malformed value aborts startup. A
# reload applies to containers started after the reload (existing
# containers keep their original cgroup limits for the rest of their
# life). Set a field to empty ("" ) to disable just that one cap.
container_cpu_limit: 2.0
container_memory_limit: 8g
container_pids_limit: 16384

# --- Per-workspace egress filtering (#1365) ---
# Deploy-wide default allow-list applied to workspaces that don't declare
# their own (same grammar as a workspace allow-list). Unset (default) =
# workspaces are unrestricted unless they declare a list.
# netfilter_default_domains:
#   - github.com:443
#   - pypi.org

# --- Uncomment to enable OIDC authentication ---
# auth_modes: both
# oidc_providers:
#   - id: my-provider
#     display-name: My SSO
#     issuer: https://keycloak.example.com/realms/main
#     client-id: klangk
#     client-secret: changeme

# --- LLM proxy (required for AI features) ---
# Single provider, all its models (passthrough) — see
# docs/architecture/llm-proxy.md for the router (multi-provider) form.
# llm-models:
#   - model_name: "*"
#     params:
#       api-base: https://api.openai.com/v1
#       api-key: your-key-here
